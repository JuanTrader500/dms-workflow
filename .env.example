# ---- Django ----
DJANGO_SECRET_KEY=cambiar-por-un-valor-largo-y-aleatorio
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:8080
TZ=America/Bogota
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=1

# ---- PostgreSQL ----
POSTGRES_DB=dms_workflow
POSTGRES_USER=dms
POSTGRES_PASSWORD=cambiar-esta-clave
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ---- IA (Gemini) ----
# IA_PROVEEDOR=gemini usa la API real; IA_PROVEEDOR=fake permite demo/pruebas sin API key
IA_PROVEEDOR=fake
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=10
IA_UMBRAL_CONFIANZA=0.85
IA_LIMITE_DIARIO=200

# ---- Archivos ----
STORAGE_ROOT=/storage
MAX_UPLOAD_MB=10

# ---- Correo (por defecto imprime en consola) ----
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=dms-workflow@localhost

# ---- Datos demo (solo desarrollo/demo) ----
SEED_DEMO=1
DEMO_PASSWORD=cambiar-en-demo
